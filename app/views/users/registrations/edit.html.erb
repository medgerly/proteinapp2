<% content_for :title, "Account Settings - Protein Tracker" %>

<div class="max-w-lg mx-auto">
  <h1 class="text-2xl font-bold text-gray-900 mb-6">Account Settings</h1>

  <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
    <%= simple_form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
      <%= render "shared/errors", object: resource %>

      <div class="grid grid-cols-2 gap-3">
        <%= f.input :first_name, required: true, autofocus: true %>
        <%= f.input :last_name, required: true %>
      </div>
      <%= f.input :email, required: true, input_html: { autocomplete: "email" } %>

      <hr class="my-4 border-gray-100" />
      <p class="text-sm text-gray-500 mb-3">Leave password blank to keep your current password</p>

      <%= f.input :password, label: "New Password", input_html: { autocomplete: "new-password" } %>
      <%= f.input :password_confirmation, label: "Confirm New Password",
          input_html: { autocomplete: "new-password" } %>
      <%= f.input :current_password, required: true, hint: "Required to confirm changes",
          input_html: { autocomplete: "current-password" } %>

      <div class="flex gap-3 pt-2">
        <%= f.submit "Save Changes",
            class: "bg-indigo-600 text-white px-5 py-2.5 rounded-lg font-medium hover:bg-indigo-700 cursor-pointer" %>
        <%= link_to "Cancel", authenticated_root_path,
            class: "text-gray-500 px-4 py-2.5 rounded-lg hover:text-gray-700" %>
      </div>
    <% end %>
  </div>
</div>
