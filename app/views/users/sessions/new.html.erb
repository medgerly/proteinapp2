<div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-indigo-50 to-purple-50">
  <div class="bg-white rounded-2xl shadow-lg p-8 w-full max-w-md">
    <div class="text-center mb-8">
      <div class="text-5xl mb-3">💪</div>
      <h1 class="text-3xl font-bold text-gray-900">Protein Tracker</h1>
      <p class="text-gray-500 mt-1">Track your protein goals, hit your targets.</p>
    </div>

    <%= simple_form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <%= f.input :email, required: true, autofocus: true, input_html: { autocomplete: "email" } %>
      <%= f.input :password, required: true, input_html: { autocomplete: "current-password" } %>
      <%= f.input :remember_me, as: :boolean, label: "Remember me" %>

      <%= f.submit "Sign In", class: "w-full bg-indigo-600 text-white py-2.5 px-4 rounded-lg font-medium hover:bg-indigo-700 transition-colors cursor-pointer mt-2" %>
    <% end %>

    <div class="text-center mt-6 text-sm text-gray-500">
      New here? <%= link_to "Create an account", new_user_registration_path, class: "text-indigo-600 font-medium hover:underline" %>
    </div>
    <div class="text-center mt-2 text-sm">
      <%= link_to "Forgot your password?", new_user_password_path, class: "text-gray-400 hover:text-indigo-600" %>
    </div>
  </div>
</div>
