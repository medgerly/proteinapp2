<% content_for :title, "Log Meal - Protein Tracker" %>

<div class="max-w-lg mx-auto">
  <div class="mb-6">
    <%= link_to "← Back to #{@goal.goal_date.strftime('%b %-d')} Goal", goal_path(@goal),
        class: "text-sm text-gray-400 hover:text-indigo-600 block mb-2" %>
    <h1 class="text-2xl font-bold text-gray-900">Log a Meal</h1>
  </div>

  <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
    <%= render "form" %>
  </div>
</div>
