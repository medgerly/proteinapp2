<% content_for :title, "#{@goal.goal_date.strftime('%b %-d')} Goal - Protein Tracker" %>

<div class="space-y-6" id="goal-<%= @goal.id %>">
  <!-- Header -->
  <div class="flex items-center justify-between">
    <div>
      <%= link_to "← Goals", goals_path, class: "text-sm text-gray-400 hover:text-indigo-600 mb-2 block" %>
      <h1 class="text-2xl font-bold text-gray-900"><%= @goal.goal_date.strftime("%A, %B %-d, %Y") %></h1>
    </div>
    <div class="flex gap-2">
      <%= link_to "Edit", edit_goal_path(@goal), class: "text-sm text-gray-500 hover:text-gray-700 px-3 py-2" %>
      <%= link_to "Log Meal", new_goal_meal_path(@goal),
          class: "bg-indigo-600 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-indigo-700" %>
    </div>
  </div>

  <!-- Progress Card -->
  <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
    <div class="flex items-end gap-4 mb-4">
      <div class="text-5xl font-bold text-indigo-600"><%= @goal.protein_total %>g</div>
      <div class="text-gray-400 text-lg mb-1">/ <%= @goal.protein_goal.to_i %>g goal</div>
      <% if @goal.met_goal? %>
        <span class="ml-2 bg-green-100 text-green-700 px-3 py-1 rounded-full text-sm font-medium">✓ Goal Met!</span>
      <% end %>
    </div>
    <div class="w-full bg-gray-100 rounded-full h-3 mb-2">
      <div class="<%= @goal.met_goal? ? 'bg-green-500' : 'bg-indigo-500' %> h-3 rounded-full"
           style="width: <%= @goal.protein_progress_pct %>%"></div>
    </div>
    <div class="flex justify-between text-sm text-gray-500 mb-5">
      <span><%= @goal.protein_remaining %>g remaining</span>
      <span><%= @goal.protein_progress_pct %>% complete</span>
    </div>

    <div class="grid grid-cols-3 gap-4 pt-5 border-t border-gray-100">
      <div class="text-center">
        <div class="text-2xl font-semibold text-blue-600"><%= @goal.carbs_total %>g</div>
        <div class="text-xs text-gray-500 mt-1">Carbs</div>
      </div>
      <div class="text-center">
        <div class="text-2xl font-semibold text-yellow-600"><%= @goal.fat_total %>g</div>
        <div class="text-xs text-gray-500 mt-1">Fat</div>
      </div>
      <div class="text-center">
        <div class="text-2xl font-semibold text-orange-600"><%= @goal.calories_total.to_i %></div>
        <div class="text-xs text-gray-500 mt-1">Calories</div>
      </div>
    </div>
  </div>

  <!-- Meal Search -->
  <%= search_form_for @q, url: goal_path(@goal), html: { class: "flex gap-3" } do |f| %>
    <%= f.search_field :meal_name_cont, placeholder: "Search meals...",
        class: "flex-1 border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
    <%= f.submit "Search", class: "bg-gray-100 text-gray-700 px-4 py-2 rounded-lg text-sm font-medium hover:bg-gray-200 cursor-pointer" %>
    <% if params[:q].present? %>
      <%= link_to "Clear", goal_path(@goal), class: "text-sm text-gray-400 hover:text-gray-600 self-center" %>
    <% end %>
  <% end %>

  <!-- Meals List -->
  <div id="meals-list">
    <% if @meals.any? %>
      <div class="space-y-3">
        <% @meals.each do |meal| %>
          <%= render "meals/meal_card", meal: meal, goal: @goal %>
        <% end %>
      </div>
      <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
    <% else %>
      <div class="bg-white rounded-xl border border-dashed border-gray-300 p-10 text-center">
        <div class="text-4xl mb-3">🍽️</div>
        <h3 class="font-semibold text-gray-700 mb-1">No meals logged yet</h3>
        <p class="text-sm text-gray-500 mb-4">Start logging your meals to track protein intake.</p>
        <%= link_to "Log First Meal", new_goal_meal_path(@goal),
            class: "bg-indigo-600 text-white px-5 py-2.5 rounded-lg text-sm font-medium hover:bg-indigo-700" %>
      </div>
    <% end %>
  </div>
</div>
