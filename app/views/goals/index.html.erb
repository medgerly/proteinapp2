<% content_for :title, "My Goals - Protein Tracker" %>

<div class="space-y-6">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold text-gray-900">My Goals</h1>
    <%= link_to "New Goal", new_goal_path,
        class: "bg-indigo-600 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-indigo-700" %>
  </div>

  <!-- Search -->
  <%= search_form_for @q, url: goals_path, html: { class: "bg-white rounded-xl border border-gray-100 shadow-sm p-4 flex gap-3" } do |f| %>
    <%= f.search_field :goal_date_gteq, type: "date", placeholder: "From date",
        class: "border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
    <%= f.search_field :goal_date_lteq, type: "date", placeholder: "To date",
        class: "border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
    <%= f.submit "Filter", class: "bg-gray-100 text-gray-700 px-4 py-2 rounded-lg text-sm font-medium hover:bg-gray-200 cursor-pointer" %>
    <%= link_to "Clear", goals_path, class: "text-sm text-gray-400 hover:text-gray-600 self-center" %>
  <% end %>

  <!-- Goals List -->
  <% if @goals.any? %>
    <div class="space-y-3">
      <% @goals.each do |goal| %>
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5 hover:shadow-md transition-shadow">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-4">
              <div class="text-center bg-indigo-50 rounded-lg px-4 py-2 min-w-16">
                <div class="text-xs text-indigo-400 font-medium"><%= goal.goal_date.strftime("%b") %></div>
                <div class="text-2xl font-bold text-indigo-700"><%= goal.goal_date.day %></div>
                <div class="text-xs text-indigo-400"><%= goal.goal_date.strftime("%a") %></div>
              </div>
              <div>
                <div class="font-semibold text-gray-900">
                  <%= goal.protein_total %>g / <%= goal.protein_goal.to_i %>g
                  <% if goal.met_goal? %>
                    <span class="ml-2 text-xs bg-green-100 text-green-700 px-2 py-0.5 rounded-full font-medium">✓ Goal Met</span>
                  <% end %>
                  <% if goal.today? %>
                    <span class="ml-2 text-xs bg-indigo-100 text-indigo-700 px-2 py-0.5 rounded-full font-medium">Today</span>
                  <% end %>
                </div>
                <div class="text-sm text-gray-400 mt-1">
                  <%= goal.meals.count %> meals · <%= goal.calories_total.to_i %> cal
                </div>
                <% if goal.notes.present? %>
                  <div class="text-xs text-gray-400 mt-1 italic"><%= goal.notes %></div>
                <% end %>
              </div>
            </div>
            <div class="flex items-center gap-4">
              <div class="text-right hidden sm:block">
                <div class="text-sm font-medium text-gray-700"><%= goal.protein_progress_pct %>%</div>
                <div class="w-24 bg-gray-100 rounded-full h-2 mt-1">
                  <div class="<%= goal.met_goal? ? 'bg-green-500' : 'bg-indigo-500' %> h-2 rounded-full"
                       style="width: <%= goal.protein_progress_pct %>%"></div>
                </div>
              </div>
              <div class="flex gap-2">
                <%= link_to "View", goal_path(goal),
                    class: "text-sm text-indigo-600 hover:text-indigo-800 font-medium" %>
                <%= link_to "Edit", edit_goal_path(goal),
                    class: "text-sm text-gray-500 hover:text-gray-700" %>
                <%= link_to "Delete", goal_path(goal),
                    data: { turbo_method: :delete, turbo_confirm: "Delete this goal and all its meals?" },
                    class: "text-sm text-red-400 hover:text-red-600" %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
  <% else %>
    <div class="bg-white rounded-xl border border-dashed border-gray-300 p-12 text-center">
      <div class="text-5xl mb-3">🎯</div>
      <h3 class="font-semibold text-gray-700 mb-1">No goals yet</h3>
      <p class="text-sm text-gray-500 mb-4">Create your first protein goal to start tracking.</p>
      <%= link_to "Create Your First Goal", new_goal_path,
          class: "bg-indigo-600 text-white px-5 py-2.5 rounded-lg text-sm font-medium hover:bg-indigo-700" %>
    </div>
  <% end %>
</div>
